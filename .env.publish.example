# Copy to .env.publish.local, then set your image repository (without a tag).
# Example: registry.example.com:5443/auricui-docs
DOCS_IMAGE=
DOCS_BUILDER=auricui-private-registry

# Optional; omit DOCS_TAG to generate a new timestamp on each publication.
# DOCS_TAG=docs-20261103-120000
# DOCS_NGINX_IMAGE=docker.xuanyuan.run/library/nginx:alpine
# DOCS_BUILDKIT_IMAGE=docker.xuanyuan.run/moby/buildkit:buildx-stable-1
