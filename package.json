{
  "name": "auricui-component-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "author": "hehuan",
  "license": "MIT",
  "scripts": {
    "release": "node scripts/release.mjs",
    "release:skill": "node scripts/release.mjs skill",
    "release:all": "node scripts/release.mjs all",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run prepare:docs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "docker:publish": "node scripts/publish-docs-image.mjs",
    "audit:components": "node scripts/audit-components.mjs",
    "test": "node --test scripts/*.test.mjs",
    "build:lib": "node scripts/build-library.mjs",
    "pack:lib": "npm run build:lib && node scripts/pack-library.mjs",
    "check:package": "node scripts/check-package.mjs",
    "pack:skill": "node scripts/build-skill-package.mjs",
    "check:skill": "node scripts/check-skill-package.mjs",
    "docs:generate": "node scripts/generate-docs.mjs",
    "check:docs": "node scripts/check-doc-content.mjs && node scripts/check-doc-examples.mjs",
    "sync:skill": "npm run docs:generate && node scripts/sync-skill-library.mjs",
    "docs:downloads": "node scripts/sync-doc-downloads.mjs",
    "prepare:docs": "npm run pack:lib && npm run sync:skill && npm run pack:skill && npm run docs:downloads",
    "check": "npm test && npm run check:package && npm run check:docs && npm run check:skill",
    "maintain:skill": "bash scripts/maintain-skill.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@lexical/react": "0.49.0",
    "lexical": "0.49.0",
    "lucide-react": "0.482.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
